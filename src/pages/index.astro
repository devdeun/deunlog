---
import Snowman from '@/components/Snowman.astro'
import IconLink from '@/components/ui/icon-link'
import { EmailIcon, GithubIcon, LinkedinIcon } from '@/components/ui/icons'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout>
  <div data-animate data-animate-speed="slow">
    <div class="my-7 sm:text-[15px]">
      <p>안녕하세요, 프론트엔드 개발자 <strong>deun</strong>입니다.</p>
      <p class="mt-3 sm:text-[15px]/[165%]">
        다양한 문제를 분석하고 해결책을 찾는 과정에서 큰 성취감을 느낍니다. 문제 해결에 그치지 않고
        이를 통해 서비스의 품질을 높여 더 나은 사용자 경험을 제공하고자 노력합니다.
      </p>
    </div>
    <div class="mb-16 mt-7">
      <div data-animate class="flex gap-0.5">
        <IconLink href="mailto:devdeun@gmail.com" aria-label="이메일" target="_self">
          <EmailIcon width="1.2rem" height="1.2rem" />
        </IconLink>
        <IconLink href="https://github.com/devdeun" aria-label="깃허브">
          <GithubIcon width="1.2rem" height="1.2rem" />
        </IconLink>
        <IconLink
          href="https://www.linkedin.com/in/%EB%8B%A4%EC%9D%80-%EA%B9%80-592a6b333/"
          aria-label="링크드인"
        >
          <LinkedinIcon width="1.2rem" height="1.2rem" />
        </IconLink>
      </div>
    </div>
    <Snowman />
  </div>
</BaseLayout>
