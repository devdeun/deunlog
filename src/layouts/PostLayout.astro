---
import '@/styles/mdx.css'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import { generateDescription } from '@/lib/mdx'
import dayjs from 'dayjs'
import BasePagination from '@/components/BasePagination.astro'

type Props = {
  post: CollectionEntry<'post'>
  prevPost: CollectionEntry<'post'>
  nextPost: CollectionEntry<'post'>
}

const { post, prevPost, nextPost } = Astro.props

const { title, date } = post.data
const description = post.data.description || generateDescription(post.body)
const formattedDate = dayjs(new Date(date)).format('YYYY/MM/DD')

const { Content } = await post.render()
---

<BaseLayout seo={{ title, description }}>
  <section>
    <h1 class="mt-14">{title}</h1>
    <time datetime={formattedDate} class="text-sm">{formattedDate}</time>
  </section>
  <section>
    <article data-animate data-animate-speed="fast" class="mdx mt-14">
      <Content />
    </article>
    <footer class="px-0">
      <hr class="mb-7 mt-4" />
      <BasePagination {prevPost} {nextPost} />
    </footer>
  </section>
</BaseLayout>
