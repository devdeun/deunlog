---
import '@/styles/animation.css'

import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Monitoring from '@/components/scripts/Monitoring.astro'
import ThemeHead from '@/components/scripts/ThemeHead.astro'
import { Toaster } from '@/components/ui/toaster'

import type { SEOModel } from '../types'

interface Props {
  seo?: SEOModel
  class?: string
}

const { seo, class: className } = Astro.props
---

<html lang="ko">
  <head>
    <BaseHead {...seo} />
    <ThemeHead />
    <Monitoring />
  </head>
  <body>
    <Header />
    <main class={className}>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <Toaster client:load />
  </body>
</html>
